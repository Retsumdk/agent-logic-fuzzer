{
  "name": "agent-logic-fuzzer",
  "description": "Deterministic adversarial fuzzing for agent decision endpoints: seeded scenario generation, timeout/crash/echo/stack-leak oracles, and delta-debugging counterexample minimisation.",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "fuzzing",
    "testing",
    "agents",
    "multi-agent",
    "property-testing",
    "adversarial",
    "oracle",
    "delta-debugging",
    "ci",
    "typescript"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "agent-logic-fuzzer": "./dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "demo": "node dist/main.js demo"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Retsumdk/agent-logic-fuzzer.git"
  }
}
